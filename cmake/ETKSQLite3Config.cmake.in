@PACKAGE_INIT@

# Provide path to Lua for the tools: compute install prefix
get_filename_component(_ETKSQLITE3_CMAKE_DIR    "${CMAKE_CURRENT_LIST_FILE}" PATH) # points to lib/cmake/ETKSQLite3
get_filename_component(_ETKSQLITE3_LIB_DIR      "${_ETKSQLITE3_CMAKE_DIR}"   PATH) # go up one level -> lib/cmake
get_filename_component(_ETKSQLITE3_LIB          "${_ETKSQLITE3_LIB_DIR}"     PATH) # go up one level -> lib
get_filename_component(_ETKSQLITE3_INSTALL_ROOT "${_ETKSQLITE3_LIB}"         PATH) # go up one level -> install root

# Include exported library targets
include("${CMAKE_CURRENT_LIST_DIR}/ETKSQLite3Targets.cmake")

# Include Tools functions
include("${CMAKE_CURRENT_LIST_DIR}/tools.cmake")

# Path to Lua executable
set(ETKSQLite3_LUA_EXECUTABLE "${_ETKSQLITE3_INSTALL_ROOT}/bin/lua/@LUA_FOLDER@/@LUA_EXE@")

# Path to Lua scripts / templates
set(ETKSQLite3_SCRIPTS_DIR "${_ETKSQLITE3_INSTALL_ROOT}/scripts")

# Generate alias for convenience
set(ETKSQLite3_generate_ws3 generate_ws3)
