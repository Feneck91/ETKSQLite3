<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="wxETKSQLite3Sample" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Script file="$(#wxetksqlite3)\scripts\compile_ws3.script" />
			<Target title="Win32 Unicode Debug">
				<Option output="exe\wxETKSQLite3Sampled" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Win32UnicodeDebug\" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add directory="$(#wx.lib)\mswud" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)\lib\gcc_dll\mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="wxETKSQLite3d" />
					<Add library="wxmsw$(#wx.verlib)ud" />
					<Add directory="$(#wx)\lib\gcc_dll" />
				</Linker>
				<ExtraCommands>
					<Add after='Win32CopyFile.bat &quot;$(#wxsqlite3)\sqlite3\lib\sqlite3.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;' />
					<Add after='xcopy &quot;$(#wx)\lib\gcc_dll\*.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot; /D /Y /s' />
				</ExtraCommands>
			</Target>
			<Target title="Win32 Unicode Release">
				<Option output="exe\wxETKSQLite3Sample" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Win32UnicodeRelease\" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="$(#wx.lib)\mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)\lib\gcc_dll\mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add library="wxETKSQLite3" />
					<Add library="wxmsw$(#wx.verlib)u" />
					<Add directory="$(#wx)\lib\gcc_dll" />
				</Linker>
				<ExtraCommands>
					<Add after='Win32CopyFile.bat &quot;$(#wxsqlite3)\sqlite3\secure\aes128\sqlite3.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;' />
					<Add after='xcopy &quot;$(#wx)\lib\gcc_dll\*.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot; /D /Y /s' />
				</ExtraCommands>
			</Target>
			<Target title="Win32 Unicode Debug Static">
				<Option output="exe\wxETKSQLite3Sampled" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Win32UnicodeDebug\" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-g" />
					<Add option="-D__WXDEBUG__" />
					<Add option="-DUSING_WX_ETK_SQLITE3_LIB" />
					<Add directory="$(#wx.lib)\mswud" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)\lib\gcc_dll\mswud" />
				</ResourceCompiler>
				<Linker>
					<Add library="StaticwxETKSQLite3d" />
					<Add library="wxmsw$(#wx.verlib)ud" />
					<Add directory="$(#wx)\lib\gcc_dll" />
				</Linker>
				<ExtraCommands>
					<Add after='Win32CopyFile.bat &quot;$(#wxsqlite3)\sqlite3\lib\sqlite3.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;' />
					<Add after='xcopy &quot;$(#wx)\lib\gcc_dll\*.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot; /D /Y /s' />
				</ExtraCommands>
			</Target>
			<Target title="Win32 Unicode Release Static">
				<Option output="exe\wxETKSQLite3Sample" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj\Win32UnicodeRelease\" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Option projectLinkerOptionsRelation="2" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DUSING_WX_ETK_SQLITE3_LIB" />
					<Add directory="$(#wx.lib)\mswu" />
				</Compiler>
				<ResourceCompiler>
					<Add directory="$(#wx)\lib\gcc_dll\mswu" />
				</ResourceCompiler>
				<Linker>
					<Add option="-s" />
					<Add library="StaticwxETKSQLite3" />
					<Add library="wxmsw$(#wx.verlib)u" />
					<Add directory="$(#wx)\lib\gcc_dll" />
				</Linker>
				<ExtraCommands>
					<Add after='Win32CopyFile.bat &quot;$(#wxsqlite3)\sqlite3\secure\aes128\sqlite3.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot;' />
					<Add after='xcopy &quot;$(#wx)\lib\gcc_dll\*.dll&quot; &quot;$(TARGET_OUTPUT_DIR)&quot; /D /Y /s' />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-pipe" />
			<Add option="-mthreads" />
			<Add option='[[if (PLATFORM == PLATFORM_MSW &amp;&amp; (GetCompilerFactory().GetCompilerVersionString(_T(&quot;gcc&quot;)) &gt;= _T(&quot;4.0.0&quot;))) print(_T(&quot;-Wno-attributes&quot;));]]' />
			<Add option="-Winvalid-pch" />
			<Add option="-include wx_pch.h" />
			<Add option="-D__GNUWIN32__" />
			<Add option="-D__WXMSW__" />
			<Add option="-DWXUSINGDLL" />
			<Add option="-DwxUSE_UNICODE" />
			<Add option="-DWX_PRECOMP" />
			<Add directory="$(#wx.include)" />
			<Add directory="$(#wx.contrib)" />
			<Add directory="$(#wxsqlite3)\sqlite3\include" />
			<Add directory="$(#wxetksqlite3)\include" />
			<Add directory="$(#wxsqlite3)\include" />
		</Compiler>
		<ResourceCompiler>
			<Add directory="$(#wx)\include" />
		</ResourceCompiler>
		<Linker>
			<Add option="-mthreads" />
			<Add directory="$(#wxetksqlite3)\lib\gcc" />
		</Linker>
		<Unit filename="resource.rc">
			<Option compilerVar="WINDRES" />
		</Unit>
		<Unit filename="wxETKSQLite3SampleApp.cpp" />
		<Unit filename="wxETKSQLite3SampleApp.h" />
		<Unit filename="wxETKSQLite3SampleDatabaseDatas.cpp" />
		<Unit filename="wxETKSQLite3SampleDatabaseDatas.h" />
		<Unit filename="wxETKSQLite3SampleDatabaseDatas.ws3">
			<Option compile="1" />
			<Option weight="25" />
			<Option compiler="gcc" use="1" buildCommand='&quot;$(#wxetksqlite3)/build/$(#wxetksqlite3.plateform)/lua52.exe&quot; &quot;$(#wxetksqlite3)/scripts/compile_ws3.lua&quot; &quot;$file&quot; &quot;$(#wxetksqlite3.genlib)&quot; &quot;$file_name.h&quot; &quot;$file_name.cpp&quot;' />
		</Unit>
		<Unit filename="wxETKSQLite3SampleMain.cpp" />
		<Unit filename="wxETKSQLite3SampleMain.h" />
		<Unit filename="wx_pch.h">
			<Option compile="1" />
			<Option weight="0" />
		</Unit>
		<Unit filename="wxsmith\wxETKSQLite3Sampleframe.wxs" />
		<Extensions>
			<code_completion />
			<envvars />
			<debugger />
			<lib_finder disable_auto="1" />
			<wxsmith version="1">
				<gui name="wxWidgets" src="wxETKSQLite3SampleApp.cpp" main="wxETKSQLite3SampleFrame" init_handlers="necessary" language="CPP" />
				<resources>
					<wxFrame wxs="wxsmith/wxETKSQLite3Sampleframe.wxs" src="wxETKSQLite3SampleMain.cpp" hdr="wxETKSQLite3SampleMain.h" fwddecl="0" i18n="1" name="wxETKSQLite3SampleFrame" language="CPP" />
				</resources>
			</wxsmith>
			<DoxyBlocks>
				<comment_style block="0" line="0" />
				<doxyfile_project output_directory="Help" use_auto_version="1" />
				<doxyfile_build extract_static="1" />
				<doxyfile_warnings />
				<doxyfile_output />
				<doxyfile_dot class_diagrams="1" />
				<general use_at_in_tags="1" />
			</DoxyBlocks>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
