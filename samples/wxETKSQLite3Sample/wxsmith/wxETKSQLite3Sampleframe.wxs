<?xml version="1.0" encoding="utf-8" ?>
<wxsmith>
	<object class="wxFrame" name="wxETKSQLite3SampleFrame">
		<object class="wxRichTextCtrl" name="ID_RICHTEXTCTRL1" variable="m_pRichTextCtrl" member="yes">
			<font>
				<sysfont>wxSYS_OEM_FIXED_FONT</sysfont>
			</font>
			<pos>80,136</pos>
			<style>wxRE_MULTILINE|wxRE_READONLY</style>
		</object>
		<object class="wxMenuBar" variable="MenuBar1" member="no">
			<object class="wxMenu" variable="Menu1" member="no">
				<label>&amp;File</label>
				<object class="wxMenuItem" name="idMenuQuit" variable="MenuItem1" member="no">
					<label>Quit</label>
					<accel>Alt-F4</accel>
					<help>Quit the application</help>
					<handler function="OnQuit" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu3" member="yes">
				<label>&amp;Database</label>
				<object class="wxMenuItem" name="idMenuAddName" variable="MenuItem4" member="yes">
					<label>Add 100 names</label>
					<handler function="OnMenuItemAddName" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="idMenuViewName" variable="MenuItem3" member="yes">
					<label>View Table Name</label>
					<handler function="OnMenuItemViewTableName" entry="EVT_MENU" />
				</object>
				<object class="wxMenuItem" name="idClearTabName" variable="MenuItem5" member="yes">
					<label>Clear Table Name</label>
					<handler function="OnMenuItemClearTableName" entry="EVT_MENU" />
				</object>
			</object>
			<object class="wxMenu" variable="Menu2" member="no">
				<label>Help</label>
				<object class="wxMenuItem" name="idMenuAbout" variable="MenuItem2" member="no">
					<label>About</label>
					<accel>F1</accel>
					<help>Show info about this application</help>
					<handler function="OnAbout" entry="EVT_MENU" />
				</object>
			</object>
		</object>
		<object class="wxStatusBar" name="ID_STATUSBAR1" variable="StatusBar1" member="yes">
			<fields>1</fields>
			<widths>-1</widths>
			<styles>wxSB_NORMAL</styles>
		</object>
	</object>
</wxsmith>
